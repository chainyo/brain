#!/bin/sh
set -eu

if [ -n "${BRAIN_ROOT:-}" ]; then
  brain_root="$BRAIN_ROOT"
elif [ -d "$PWD/content" ] && [ -f "$PWD/.chezmoiroot" ]; then
  brain_root="$PWD"
else
  brain_root="$HOME/brain"
fi
content_dir="$brain_root/content"

if [ -n "${QMD_CONFIG_DIR:-}" ]; then
  qmd_config_dir="$QMD_CONFIG_DIR"
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  qmd_config_dir="$XDG_CONFIG_HOME/qmd"
else
  qmd_config_dir="$HOME/.config/qmd"
fi
qmd_config="$qmd_config_dir/brain.yml"

if [ -n "${XDG_CACHE_HOME:-}" ]; then
  qmd_cache_dir="$XDG_CACHE_HOME/qmd"
else
  qmd_cache_dir="$HOME/.cache/qmd"
fi

if [ -n "${MISE_BIN:-}" ]; then
  mise_bin="$MISE_BIN"
elif [ -x "$HOME/.local/bin/mise" ]; then
  mise_bin="$HOME/.local/bin/mise"
elif command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
else
  printf '%s\n' 'Mise not found in PATH or ~/.local/bin.' >&2
  exit 1
fi

if [ ! -d "$content_dir" ]; then
  printf 'Brain vault not found: %s\n' "$content_dir" >&2
  exit 1
fi

if [ ! -x "$mise_bin" ]; then
  printf 'Mise not found: %s\n' "$mise_bin" >&2
  exit 1
fi

content_dir="$(cd "$content_dir" && pwd -P)"

# Remove a legacy default-index duplicate only when it points at this vault.
# Preserve the default index when it contains any unrelated collections.
default_qmd_config="$qmd_config_dir/index.yml"
if [ -f "$default_qmd_config" ]; then
  default_brain_collections="$(
    CONTENT_DIR="$content_dir" "$mise_bin" exec -- yq -r \
      '(.collections // {}) | to_entries[] |
        select(.value.path == strenv(CONTENT_DIR)) | .key' \
      "$default_qmd_config" 2>/dev/null || true
  )"
  default_collection_count="$(
    "$mise_bin" exec -- yq -r '.collections // {} | length' \
      "$default_qmd_config" 2>/dev/null || true
  )"
  if [ -n "$default_brain_collections" ]; then
    if [ "$default_collection_count" = "1" ]; then
      rm -f \
        "$default_qmd_config" \
        "$qmd_cache_dir/index.sqlite" \
        "$qmd_cache_dir/index.sqlite-shm" \
        "$qmd_cache_dir/index.sqlite-wal"
      printf '%s\n' 'Removed duplicate default QMD index for the brain vault.'
    else
      printf '%s\n' "$default_brain_collections" | while IFS= read -r name; do
        "$mise_bin" exec -- qmd collection remove "$name"
      done
      printf '%s\n' 'Removed the brain vault from the shared default QMD index.'
    fi
  fi
fi

qmd() {
  "$mise_bin" exec -- qmd --index brain "$@"
}

codex() {
  "$mise_bin" exec -- codex "$@"
}

collection="$(qmd collection show brain 2>/dev/null || true)"
collection_path="$(printf '%s\n' "$collection" | sed -n 's/^  Path:[[:space:]]*//p')"

if [ "$collection_path" != "$content_dir" ]; then
  if [ -n "$collection" ]; then
    qmd collection remove brain
  fi
  qmd collection add "$content_dir" --name brain
fi

if [ ! -f "$qmd_config" ]; then
  printf 'QMD configuration not found: %s\n' "$qmd_config" >&2
  exit 1
fi

# Keep public bootstrap guidance and local Obsidian state out of knowledge
# retrieval. These patterns are relative to the collection root.
"$mise_bin" exec -- yq -i \
  '.collections.brain.ignore = ["AGENTS.md", ".obsidian/**"]' \
  "$qmd_config"

qmd context add qmd://brain "Private Obsidian vault"
BRAIN_ROOT="$brain_root" "$HOME/.local/bin/brain-qmd-refresh"

current_mcp="$(codex mcp get qmd --json 2>/dev/null || true)"
# The dollar-prefixed name below is a jq variable, not a shell variable.
# shellcheck disable=SC2016
if ! printf '%s\n' "$current_mcp" | "$mise_bin" exec -- jq -e \
  --arg command "$mise_bin" \
  '.transport.type == "stdio"
    and .transport.command == $command
    and .transport.args == ["exec", "--", "qmd", "--index", "brain", "mcp"]' \
  >/dev/null 2>&1; then
  if [ -n "$current_mcp" ]; then
    codex mcp remove qmd
  fi
  codex mcp add qmd -- "$mise_bin" exec -- qmd --index brain mcp
fi

qmd status
